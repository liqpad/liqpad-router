# Base mainnet RPC used by deployment scripts and fork tests.
BASE_RPC_URL=https://mainnet.base.org

# Deployment wallet private key. Never commit a populated .env file.
PRIVATE_KEY=

# Etherscan API V2 key used for Base contract verification.
ETHERSCAN_API_KEY=

# Minimal Base-mainnet smoke tests. Values are raw token units.
SMOKE_ETH_BUY_IN=1000000000000
SMOKE_USDC_BUY_IN=10000
SMOKE_MIN_VVV_BUY=1
SMOKE_MIN_B20_BUY=1
# Required by either sell script. Read the post-buy B20 balance on-chain first.
SMOKE_SELL_B20_IN=
SMOKE_MIN_VVV_SELL=1
SMOKE_MIN_ETH_SELL=1
SMOKE_MIN_USDC_SELL=1
